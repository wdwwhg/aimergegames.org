# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# deploy
.vercel

# editors (keep .cursor/skills — cross-agent symlink to .claude/skills)
.idea
.vscode
.cursor/*
!.cursor/skills

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — local files hold secrets, never commit (keep .env.example tracked)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# database
/data/
/drizzle/
src/config/db/schema.ts

# npm (project uses pnpm)
package-lock.json

# Runtime image uploads (no-storage local fallback)
/public/uploads/

# vinext-branch artifacts that linger in the worktree after switching back to dev
# (dist/ from `vinext build`, wrangler.jsonc from the vinext postinstall)
dist/
wrangler.jsonc

# Local dependency cache and verification artifacts
.pnpm-store/
.pnpm-home/
.artifacts/
.test-data/
output/playwright/

# Keep machine-specific package-manager settings local.
/.npmrc
